# ==============================================================================
# Safety Graph Orchestrator - Environment Configuration Template
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ==============================================================================

# General Application Settings
SAFETY_GRAPH_APP_NAME="safety-graph-orchestrator"
SAFETY_GRAPH_APP_VERSION="0.1.0"
SAFETY_GRAPH_LOG_LEVEL="INFO" # Options: DEBUG, INFO, WARNING, ERROR

# Local LLM Inference (Ollama)
# When running on host: http://localhost:11434
# When running in docker-compose: http://ollama:11434
SAFETY_GRAPH_OLLAMA_BASE_URL="http://localhost:11434"
SAFETY_GRAPH_OLLAMA_MODEL="llama3.2:latest"
SAFETY_GRAPH_LLM_TEMPERATURE=0.1
SAFETY_GRAPH_LLM_TIMEOUT_SECONDS=60.0

# Fail-safe Fallback: Set to true to automatically fall back to deterministic mock
# inference if the Ollama daemon is unreachable or offline (ideal for CI/CD)
SAFETY_GRAPH_USE_MOCK_LLM_FALLBACK=true

# ChromaDB Persistent Vector Store & RAG
SAFETY_GRAPH_CHROMA_PERSIST_DIR=".chromadb"
SAFETY_GRAPH_CHROMA_COLLECTION_NAME="safety_sops_and_regulations"
SAFETY_GRAPH_RETRIEVAL_TOP_K=4
SAFETY_GRAPH_SIMILARITY_THRESHOLD=0.70

# Risk Thresholds & LangGraph Human-in-the-Loop Gating
SAFETY_GRAPH_AUTO_ESCALATE_CRITICAL=true
SAFETY_GRAPH_MAX_RCA_DEPTH=5

# HTTP Server / Portal Settings
HOST="0.0.0.0"
PORT=8000
